				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<u>Определим температуру "излома" температурного графика</u>
				</p>
			</text>
		</region>
		<region region-id="2329" left="6" top="2642.25" width="275.25" height="27.75" align-x="40.5" align-y="2658" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:id xml:space="preserve" subscript="1_min">τ</ml:id>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:plus/>
							<ml:id xml:space="preserve" subscript="в.р">t</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="о">Δt'</ml:id>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="о_отн_tн.и.">Q</ml:id>
									<ml:real>0.8</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:parens>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve" subscript="о">δt'</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">Θ'</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:parens>
							<ml:id xml:space="preserve" subscript="о_отн_tн.и.">Q</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:apply>
			</math>
			<rendering item-idref="108"/>
		</region>
		<region region-id="2331" left="6" top="2684.25" width="240.75" height="27.75" align-x="20.25" align-y="2700" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
