			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Температура сетевой воды в обратных трубопроводах вентиляционных калориферов близка к температуре в обратном трубопроводе, поэтому принимаем эти температуры одинаковыми</p>
			</text>
		</region>
		<region region-id="2735" left="6" top="4694.25" width="292.5" height="12" align-x="33" align-y="4704" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<u>Определение расхода сетевой воды на отопление и вентиляцию</u>
				</p>
			</text>
		</region>
		<region region-id="2736" left="6" top="4720.5" width="270.75" height="35.25" align-x="41.25" align-y="4740" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="о.в.с.">G'</ml:id>
					<ml:symEval style="default" hide-keywords="true" hide-lhs="false">
						<ml:symEval style="default" hide-keywords="true" hide-lhs="false">
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:real>3600</ml:real>
										<ml:id xml:space="preserve" subscript="о.в">Q'</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve">c</ml:id>
										<ml:parens>
											<ml:apply>
												<ml:minus/>
												<ml:id xml:space="preserve" subscript="1">τ'</ml:id>
												<ml:id xml:space="preserve" subscript="о2">τ'</ml:id>
											</ml:apply>
										</ml:parens>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:pow/>
									<ml:real>10</ml:real>
									<ml:real>-3</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:command>
								<ml:sequence>
									<ml:id xml:space="preserve">explicit</ml:id>
									<ml:id xml:space="preserve">ALL</ml:id>
								</ml:sequence>
							</ml:command>
							<ml:symResult>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:mult/>
											<ml:real>3600</ml:real>
											<ml:real>14960</ml:real>
										</ml:apply>
