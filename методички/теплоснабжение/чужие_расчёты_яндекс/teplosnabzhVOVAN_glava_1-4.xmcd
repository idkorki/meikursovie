				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Задаем значения <region region-id="2351" left="87.75" top="2793" width="55.5" height="16.5" align-x="114.75" align-y="2802" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:id xml:space="preserve" subscript="о_отн_tн.и." xmlns:ml="http://schemas.mathsoft.com/math30">Q</ml:id>
