					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:plus/>
							<ml:real>20</ml:real>
							<ml:apply>
								<ml:mult/>
								<ml:real>62.5</ml:real>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="о_отн_tн.и.">Q</ml:id>
									<ml:real>0.8</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:parens>
								<ml:apply>
									<ml:minus/>
									<ml:real>80</ml:real>
									<ml:apply>
										<ml:div/>
										<ml:real>25</ml:real>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:parens>
							<ml:id xml:space="preserve" subscript="о_отн_tн.и.">Q</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:apply>
