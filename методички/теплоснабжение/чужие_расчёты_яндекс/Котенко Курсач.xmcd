		<region region-id="3012" left="18" top="4407" width="425.25" height="38.25" align-x="45" align-y="4416" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f size="9">
						<b>
							<u>Определение температур воды в подающих трубопроводах на входе в ТП τ</u>
						</b>
					</f>
					<f size="9">
						<b>
							<u>
								<sub>1</sub>
							</u>
						</b>
					</f>
					<f size="9">
						<b>
							<u>, перед отопительными приборами отопительных систем τ</u>
						</b>
					</f>
					<f size="9">
						<u>
							<b>
								<sub>01</sub>
							</b>
						</u>
					</f>
					<b>
						<u>
							<f size="9"> и после приборов отопительных систем τ</f>
						</u>
					</b>
					<f size="9">
						<b>
							<u>
								<sub>02 </sub>
							</u>
						</b>
					</f>
					<f size="9">
						<b>
							<u>при различных температурах наружнего воздуха.</u>
						</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="3013" left="18" top="4454.25" width="258" height="27.75" align-x="51.75" align-y="4470" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
