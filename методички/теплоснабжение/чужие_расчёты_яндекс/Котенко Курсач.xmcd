				<ml:provenance expr-id="1" xmlns:ml="http://schemas.mathsoft.com/math30">
					<originRef doc-id="ABF5420D-34E6-4542-A00E-B0EC9ECEA4B2" version-id="FED59B42-B946-4BFD-9DF5-01555FB48160" branch-id="00000000-0000-0000-0000-000000000000" revision-num="17157020" is-modified="false" region-id="0" href="C:\Users\Admin\Downloads\teplosnabzhVOVAN_glava_1-4.xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
