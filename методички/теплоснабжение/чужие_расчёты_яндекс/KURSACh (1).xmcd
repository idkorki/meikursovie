					<ml:real>57</ml:real>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:mult/>
							<ml:parens>
								<ml:real>-7.5</ml:real>
							</ml:parens>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve" subscript="o_отн">Q'</ml:id>
								<ml:real>0.8</ml:real>
							</ml:apply>
						</ml:apply>
