			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Определим температуру и расход сетевой воды в обратном турбопроводе в неотопительный период:</p>
			</text>
		</region>
		<region region-id="140589" left="18" top="9048" width="423" height="54" align-x="33.75" align-y="9090" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="н">x</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:symEval style="equals" hide-keywords="true" hide-lhs="false">
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:plus/>
									<ml:apply>
										<ml:neg/>
										<ml:apply>
											<ml:div/>
											<ml:real>1</ml:real>
											<ml:id xml:space="preserve">Φ</ml:id>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:sqrt/>
										<ml:apply>
											<ml:plus/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:apply>
													<ml:pow/>
													<ml:id xml:space="preserve">Φ</ml:id>
													<ml:real>2</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:real>1.4</ml:real>
												<ml:parens>
													<ml:apply>
														<ml:minus/>
														<ml:apply>
															<ml:div/>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve" subscript="1_min">τ</ml:id>
																<ml:id xml:space="preserve" subscript="х_л">t</ml:id>
															</ml:apply>
															<ml:apply>
																<ml:minus/>
																<ml:id xml:space="preserve" subscript="г_т">t</ml:id>
																<ml:id xml:space="preserve" subscript="х_л">t</ml:id>
															</ml:apply>
														</ml:apply>
														<ml:real>0.65</ml:real>
													</ml:apply>
												</ml:parens>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:real>0.7</ml:real>
							</ml:apply>
							<ml:command>
								<ml:sequence>
									<ml:id xml:space="preserve">explicit</ml:id>
									<ml:id xml:space="preserve">ALL</ml:id>
								</ml:sequence>
							</ml:command>
							<ml:symResult>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:neg/>
											<ml:apply>
												<ml:div/>
												<ml:real>1</ml:real>
												<ml:real>2.29</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:sqrt/>
											<ml:apply>
												<ml:plus/>
												<ml:apply>
													<ml:div/>
													<ml:real>1</ml:real>
													<ml:apply>
														<ml:pow/>
														<ml:real>2.29</ml:real>
														<ml:real>2</ml:real>
													</ml:apply>
												</ml:apply>
												<ml:apply>
													<ml:mult/>
													<ml:real>1.4</ml:real>
													<ml:parens>
														<ml:apply>
															<ml:minus/>
															<ml:apply>
																<ml:div/>
																<ml:apply>
																	<ml:minus/>
																	<ml:real>77</ml:real>
																	<ml:real>15</ml:real>
																</ml:apply>
																<ml:apply>
																	<ml:minus/>
																	<ml:real>71</ml:real>
																	<ml:real>15</ml:real>
																</ml:apply>
															</ml:apply>
															<ml:real>0.65</ml:real>
														</ml:apply>
													</ml:parens>
												</ml:apply>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:real>0.7</ml:real>
								</ml:apply>
							</ml:symResult>
						</ml:symEval>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>0.67818955511036316</ml:real>
						</result>
					</ml:eval>
				</ml:define>
				<resultFormat numeric-only="false">
					<decimal precision="3" show-trailing-zeros="false" radix="dec" complex-threshold="10" zero-threshold="15" imaginary-value="i"/>
					<matrix display-style="auto" expand-nested-arrays="false"/>
					<unit format-units="true" simplify-units="true" fractional-unit-exponent="false"/>
				</resultFormat>
			</math>
			<rendering item-idref="313"/>
		</region>
		<region region-id="140590" left="18" top="9112.5" width="85.5" height="41.25" align-x="36" align-y="9132" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
