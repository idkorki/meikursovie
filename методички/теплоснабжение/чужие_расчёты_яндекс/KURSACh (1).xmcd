		<region region-id="3496" left="18" top="604.5" width="188.25" height="37.5" align-x="35.25" align-y="630" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="p">F</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:symEval style="equals" hide-keywords="true" hide-lhs="false">
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="ж">f</ml:id>
										<ml:id xml:space="preserve">N</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:pow/>
										<ml:real>10</ml:real>
										<ml:real>4</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:id xml:space="preserve">f</ml:id>
							</ml:apply>
							<ml:command>
								<ml:sequence>
									<ml:id xml:space="preserve">explicit</ml:id>
									<ml:id xml:space="preserve">ALL</ml:id>
								</ml:sequence>
							</ml:command>
							<ml:symResult>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult/>
											<ml:real>21</ml:real>
											<ml:real>8000</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:real>10</ml:real>
											<ml:real>4</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:real>5600</ml:real>
								</ml:apply>
							</ml:symResult>
						</ml:symEval>
