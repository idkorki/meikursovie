		<region region-id="12505" left="42" top="2529" width="152.25" height="16.5" align-x="78" align-y="2538" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
