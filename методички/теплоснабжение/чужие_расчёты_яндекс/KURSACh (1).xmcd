		<region region-id="12508" left="30" top="2552.25" width="468.75" height="24" align-x="37.5" align-y="2562" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Для поиска температуры наружного воздуха, при котором происходит "излом" графика, воспользуемся уравнением:</p>
			</text>
		</region>
		<region region-id="12509" left="42" top="2582.25" width="228.75" height="27.75" align-x="76.5" align-y="2598" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:id xml:space="preserve" subscript="1_min">τ</ml:id>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:plus/>
							<ml:id xml:space="preserve" subscript="вр">t</ml:id>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve" subscript="o">Δt'</ml:id>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="o_отн">Q'</ml:id>
									<ml:real>0.8</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:parens>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve" subscript="o">δτ'</ml:id>
									<ml:apply>
										<ml:div/>
										<ml:id xml:space="preserve">θ'</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:parens>
							<ml:id xml:space="preserve" subscript="o_отн">Q'</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:apply>
			</math>
			<rendering item-idref="113"/>
		</region>
		<region region-id="12479" left="42" top="2618.25" width="205.5" height="27.75" align-x="56.25" align-y="2634" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:equal/>
					<ml:real>77</ml:real>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:plus/>
							<ml:real>20</ml:real>
							<ml:apply>
								<ml:mult/>
								<ml:parens>
									<ml:real>-7.5</ml:real>
								</ml:parens>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve" subscript="o_отн">Q'</ml:id>
									<ml:real>0.8</ml:real>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:parens>
								<ml:apply>
									<ml:minus/>
									<ml:real>60</ml:real>
									<ml:apply>
										<ml:div/>
										<ml:real>25</ml:real>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:parens>
							<ml:id xml:space="preserve" subscript="o_отн">Q'</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:apply>
			</math>
			<rendering item-idref="114"/>
		</region>
		<region region-id="12480" left="42" top="2649" width="156.75" height="22.5" align-x="56.25" align-y="2664" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
